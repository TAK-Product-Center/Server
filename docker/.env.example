# Copy to .env next to compose.yaml. Everything here is read by docker compose.
DB_PASSWORD=change-me
CERT_PASS=atakatak
# CRL enforcement is on by default; maintenance and reload procedure: RUN.md section 4.
CRL_ENABLED=true
CA_NAME=TAK-CONTAINER-CA
SERVER_CN=takserver-config
CERT_ORGANIZATION=Lastwall
CERT_ORGANIZATIONAL_UNIT=TAKOIDC

# OIDC. Leave OIDC_ENABLED=false for a plain certificate-only server.
# qa/lab-up.sh copies this file if needed and exports lab OIDC URLs/audiences with OIDC enabled.
OIDC_ENABLED=false
OIDC_NAME=idp
OIDC_CLIENT_ID=tak-web
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://takserver.example.com:8446/login/redirect
OIDC_CONFIGURATION_URI=https://idp.example.com/.well-known/openid-configuration
OIDC_ISSUER=https://idp.example.com
OIDC_AUDIENCE=tak-web,atak-civ
OIDC_ANDROID_CLIENT_ID=atak-civ
OIDC_SCOPES="openid profile groups"
OIDC_GROUP_MAPPINGS=tak_ops:Operations:both,tak_admin:Operations
OIDC_ADMIN_CLAIM_NAME=groups
OIDC_ADMIN_CLAIM_VALUE=tak_admin
# Truststore that holds the IdP chain (JKS). Relative to /opt/tak inside the container.
OIDC_TRUSTSTORE_FILE=certs/files/truststore-root.jks

# Heaps, in MB. Defaults suit a 4 GB host.
CONFIG_HEAP=384
MESSAGING_HEAP=640
API_HEAP=640

# acceptance profile only
KC_ADMIN=admin
KC_ADMIN_PASSWORD=change-me
EXTRA_SERVER_CERTS=idp
